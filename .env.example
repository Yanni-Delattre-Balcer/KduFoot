# ─────────────────────────────────────────────────────────────────────────────
# KduFoot — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs.
# Ne commitez JAMAIS le fichier .env dans Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth0 ─────────────────────────────────────────────────────────────────────
# Votre domaine Auth0 (ex: kdufoot.eu.auth0.com)
AUTH0_DOMAIN=your-tenant.eu.auth0.com

# Client ID de l'application Auth0 (SPA)
AUTH0_CLIENT_ID=your_auth0_client_id

# Client Secret (backend seulement, ne pas exposer côté client)
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# Audience de l'API Auth0 (ex: https://api.kdufoot.com)
AUTH0_AUDIENCE=https://api.kdufoot.com

# Scopes OAuth2 (ex: openid profile email)
AUTH0_SCOPE=openid profile email

# ── Auth0 Management API ──────────────────────────────────────────────────────
# Client ID de la Machine-to-Machine Application pour la Management API
AUTH0_MANAGEMENT_API_CLIENT_ID=your_m2m_client_id

# Client Secret de la M2M Application
AUTH0_MANAGEMENT_API_CLIENT_SECRET=your_m2m_client_secret

# Permissions assignées automatiquement aux nouveaux utilisateurs (séparées par virgule)
AUTH0_AUTOMATIC_PERMISSIONS=read:api

# ── Permissions ───────────────────────────────────────────────────────────────
READ_PERMISSION=read:api
WRITE_PERMISSION=write:api
ADMIN_PERMISSION=admin:api
ADMIN_AUTH0_PERMISSION=auth0:admin:api
BACKUP_PERMISSION=backup:api

# ── URLs ──────────────────────────────────────────────────────────────────────
# URL de l'API Worker (dev: http://127.0.0.1:8787, prod: https://api.kdufoot.com)
API_BASE_URL=http://127.0.0.1:8787

# URL de l'API pour le frontend Vite
VITE_API_URL=http://127.0.0.1:8787

# Origines CORS autorisées (dev: http://localhost:5173, prod: https://kdufoot.com)
CORS_ORIGIN=http://localhost:5173

# ── Cloudflare ────────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_DATABASE_ID=your_d1_database_id

# ── Google APIs ───────────────────────────────────────────────────────────────
# Clé API Google Maps (pour le géocodage et Distance Matrix)
GOOGLE_API_KEY=your_google_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Modèle Gemini (optionnel, ex: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# ── API Gouvernementale SIRET ─────────────────────────────────────────────────
# URL de l'API Entreprise INSEE (ex: https://recherche-entreprises.api.gouv.fr/search)
SIRET_API_URL=https://recherche-entreprises.api.gouv.fr/search

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Générer avec: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ── Authentication Provider ───────────────────────────────────────────────────
# Type de fournisseur d'authentification: "auth0" ou "dex"
AUTHENTICATION_PROVIDER_TYPE=auth0

# ── Dex (alternative à Auth0, optionnel) ──────────────────────────────────────
DEX_AUTHORITY=
DEX_CLIENT_ID=
DEX_REDIRECT_URI=
DEX_SCOPE=
DEX_AUDIENCE=
DEX_TOKEN_ISSUER=
DEX_JWKS_ENDPOINT=

# ── Super Admin (optionnel, jamais dans le code source) ───────────────────────
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_ID=

# ── Tokens internes (optionnel) ───────────────────────────────────────────────
CRYPTOKEN=
AUTH0_TOKEN=
AUTH0_SUB=
