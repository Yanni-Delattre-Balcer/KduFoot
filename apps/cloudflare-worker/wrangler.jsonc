{
	"name": "kdufoot-api",
	"compatibility_date": "2024-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/index.ts",
	"vars": {
		"ENVIRONMENT": "production",
		"API_BASE_URL": "https://api.kdufoot.com",
		"CORS_ORIGIN": "https://kdufoot.com",
		"AUTH0_DOMAIN": "dev-vagn7ta27qabl45d.us.auth0.com",
		"AUTH0_AUDIENCE": "https://api.kdufoot.com",
		"AUTHENTICATION_PROVIDER_TYPE": "auth0",
		"READ_PERMISSION": "read:api",
		"WRITE_PERMISSION": "write:api",
		"ADMIN_PERMISSION": "admin:api",
		"BACKUP_PERMISSION": "backup:api",
		"ADMIN_AUTH0_PERMISSION": "auth0:admin:api",
		"SIRET_API_URL": "https://recherche-entreprises.api.gouv.fr/search"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": false
		}
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kdufoot-db",
			"database_id": "22a59be4-5a74-43f7-9f25-2e9fe7ae4f5e"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV_CACHE",
			"id": "d5f9c08aeb9e4cbaa708042aa30dfa02"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "WEBSOCKET_HUB",
				"class_name": "WebSocketHub"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"WebSocketHub"
			]
		}
	]
	/*
	"r2_buckets": [
		{
			"binding": "VIDEOS_BUCKET",
			"bucket_name": "kdufoot-videos"
		},
		{
			"binding": "THUMBNAILS_BUCKET",
			"bucket_name": "kdufoot-thumbnails"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV_CACHE",
			"id": "your-kv-namespace-id"
		}
	]
	]
	*/,
	"smart_placement": {
		"enabled": true
	}
}