{
  "name": "@kdufoot/client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run openapi && vite",
    "dev:env": "npm run openapi && dotenv -e ../../.env -- vite",
    "openapi": "node --experimental-strip-types get-openapi.ts",
    "build": "npm run openapi && tsc && vite build",
    "build:env": "npm run openapi && tsc && npx dotenv-cli -e ../../.env -- vite build",
    "lint": "eslint ./src/**/**/*.{ts,tsx} --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "preview:env": "bash ./scripts/preview-ensure.sh",
    "update:heroui:cli": "npx heroui-cli@latest upgrade --all",
    "update:heroui": "node --no-warnings --import 'data:text/javascript,import { register } from \"node:module\"; import { pathToFileURL } from \"node:url\"; register(\"ts-node/esm\", pathToFileURL(\"./\"));' ./update-heroui.ts"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.13.0",
    "@heroui/autocomplete": "^2.3.32",
    "@heroui/button": "^2.2.30",
    "@heroui/card": "^2.2.27",
    "@heroui/chip": "^2.2.24",
    "@heroui/code": "^2.2.23",
    "@heroui/date-picker": "^2.3.31",
    "@heroui/divider": "^2.2.23",
    "@heroui/dropdown": "^2.3.30",
    "@heroui/image": "^2.2.19",
    "@heroui/input": "^2.4.31",
    "@heroui/kbd": "^2.2.24",
    "@heroui/link": "^2.2.25",
    "@heroui/modal": "^2.2.28",
    "@heroui/navbar": "^2.2.28",
    "@heroui/number-input": "^2.0.21",
    "@heroui/pagination": "^2.2.26",
    "@heroui/progress": "^2.2.24",
    "@heroui/scroll-shadow": "^2.3.19",
    "@heroui/select": "^2.4.31",
    "@heroui/shared-utils": "^2.1.12",
    "@heroui/skeleton": "^2.2.18",
    "@heroui/snippet": "^2.2.31",
    "@heroui/spinner": "^2.2.27",
    "@heroui/switch": "^2.2.26",
    "@heroui/system": "^2.4.27",
    "@heroui/table": "^2.2.30",
    "@heroui/tabs": "^2.2.27",
    "@heroui/theme": "^2.4.26",
    "@heroui/toast": "^2.0.20",
    "@heroui/tooltip": "^2.2.27",
    "@heroui/use-clipboard": "^2.1.9",
    "@react-aria/visually-hidden": "3.8.30",
    "@react-stately/data": "^3.15.1",
    "@react-types/shared": "^3.33.0",
    "@tailwindcss/postcss": "^4.2.0",
    "dompurify": "^3.3.3",
    "face-api.js": "^0.22.2",
    "focus-trap-react": "^12.0.0",
    "framer-motion": "12.33.0",
    "i18next": "^25.8.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "jose": "^6.1.3",
    "lucide-react": "^0.577.0",
    "oidc-client-ts": "^3.4.1",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^15.7.3",
    "react-router-dom": "^7.13.0",
    "swr": "^2.4.0",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "^4.2.0"
